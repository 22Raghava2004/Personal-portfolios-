DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Optional local PostgreSQL or Aiven connection URL; omit to use SQLite locally.
DATABASE_URL=
DATABASE_SSL=false
# For Aiven's secure service integration, the platform supplies PROJECT_CA_CERT.
# Admin user is created at startup only when all three values are configured.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-long-random-password

# Optional persistent S3-compatible media storage (e.g. Cloudflare R2 / AWS S3).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=true
